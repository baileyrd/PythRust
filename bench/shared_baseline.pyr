# Control for shared.pyr: the same work, called directly, so nothing is
# marked and every count change is a plain load and store.
def total(rows: list[str]) -> int:
    n = 0
    for k in range(40):
        for s in rows:
            n += len(s)
    return n


def main() -> None:
    rows = []
    for i in range(200000):
        rows.append(str(i))
    print(total(rows))


main()
