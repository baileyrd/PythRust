# Numeric loop: Collatz step counts, int arithmetic and branches only.
def steps(n: int) -> int:
    count = 0
    while n != 1:
        if n % 2 == 0:
            n = n // 2
        else:
            n = 3 * n + 1
        count += 1
    return count


total = 0
longest = 0
for i in range(1, 1000000):
    s = steps(i)
    total += s
    if s > longest:
        longest = s
print(total, longest)
