# fclone_fast: fclone-lite hashing every candidate with xxh3-128 in Rust,
# in parallel and in one call, through the `fastfs` binding (M6b driver,
# docs/research/rust-interop.md#driver-fast-fclone-lite). The walk and the
# grouping are fclone_lite.py's; an unreadable file has the digest "" and
# is skipped, as fclone_lite.py skips its OSError. Build it with
#   pythrust build --rust fastfs=apps/fclone-lite/fastfs apps/fclone-lite/fclone_fast.pyr
import fastfs
import os
import sys


def collect(root: str, by_size: dict[int, list[str]]) -> None:
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return
    for name in names:
        path = os.path.join(root, name)
        if os.path.islink(path):
            continue
        if os.path.isdir(path):
            collect(path, by_size)
        elif os.path.isfile(path):
            size = os.path.getsize(path)
            if size in by_size:
                by_size[size].append(path)
            else:
                by_size[size] = [path]


def groups(paths: list[str], digests: list[str], start: int) -> list[list[str]]:
    by_hash: dict[str, list[str]] = {}
    for i in range(len(paths)):
        h = digests[start + i]
        path = paths[i]
        if h == "":
            continue
        if h in by_hash:
            by_hash[h].append(path)
        else:
            by_hash[h] = [path]
    found: list[list[str]] = []
    for h in sorted(by_hash):
        if len(by_hash[h]) > 1:
            found.append(by_hash[h])
    return found


def main() -> None:
    root = sys.argv[1] if len(sys.argv) > 1 else "."
    by_size: dict[int, list[str]] = {}
    collect(root, by_size)
    sizes: list[int] = []
    candidates: list[str] = []
    for size in sorted(by_size):
        if len(by_size[size]) < 2:
            continue
        sizes.append(size)
        for path in by_size[size]:
            candidates.append(path)
    # One call hashes every candidate, so the threads start once, not
    # once per size group.
    digests = fastfs.group_xxh3(candidates)
    start = 0
    first = True
    for size in sizes:
        for group in groups(by_size[size], digests, start):
            if not first:
                print()
            first = False
            print(size, "bytes:")
            for path in group:
                print(" ", path)
        start += len(by_size[size])


main()
