# expect-exit: 1
# expect-error: write `pause`
# deviation: a tempered slice bound must mark its task wait, as any expression must.
import concurrent.futures

temper def worker(n: int) -> int:
    return n

temper def main() -> None:
    xs = [1, 2, 3]
    with concurrent.futures.ThreadPoolExecutor() as ex:
        f = ex.submit(worker, 2)
        print(xs[:f.result()])
main()
