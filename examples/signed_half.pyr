# Signed-i64 half lowering, with dynamic and noninteger fallbacks.
def half(n: int) -> int:
    return n // 2


def bit(n: int) -> int:
    return n % 2


def general(n: int, d: int) -> int:
    return n // d


def residue(n: int, d: int) -> int:
    return n % d


def touched(n: int) -> int:
    print("numerator", n)
    return n


def fault(n: int) -> int:
    print("fault", n)
    return 7 // n


