for n in [-7, -2, -1, 0, 1, 2, 7]:
    for d in [-3, -1, 0, 1, 2, 3, 10]:
        try:
            print(n, d, general(n, d), residue(n, d))
        except ZeroDivisionError:
            print("zero", n, d)
print(residue(-9223372036854775808, -1))
print(touched(-7) // 2, touched(-7) % 2)
for d in [0, 1]:
    try:
        print(fault(d) // 2)
    except ZeroDivisionError:
        print("caught quotient numerator")
    try:
        print(fault(d) % 2)
    except ZeroDivisionError:
        print("caught remainder numerator")
for f in [-7.5, -0.0, 0.0, 7.5]:
    print(f // 2, f % 2)
for flag in [False, True]:
    print(flag // 2, flag % 2)
xs = [-7]
try:
    print(xs[1] // 2)
except IndexError:
    print("caught index numerator")
try:
    print(xs[1] % 2)
except IndexError:
    print("caught index remainder")
print("complete")
