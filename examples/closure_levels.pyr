from collections.abc import Callable


def outer(a: int) -> Callable[[int], int]:
    def middle(b: int) -> Callable[[int], int]:
        def inner(c: int) -> int:
            return a * 100 + b * 10 + c

        return inner

    return middle(2)


def with_lambda(a: int) -> Callable[[int], int]:
    def middle(b: int) -> Callable[[int], int]:
        return lambda c: a * 100 + b * 10 + c

    return middle(3)


def main() -> None:
    print(outer(1)(3))
    print(with_lambda(4)(5))


main()
