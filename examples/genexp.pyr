# Generator expressions as a reducer's argument (D119-D122): each runs as
# the loop it stands for, so the body interleaves with the reducer, the
# first iterable is evaluated once at the call, and `any`/`all` stop at
# the item that decides.


def seen(x):
    print("see", x)
    return x


xs = [3, 1, 4, 1, 5]
print(sum(x * x for x in xs))
print(sum((x for x in xs), 10), sum((x for x in xs), start=-1))
print(sum(x for x in xs if x > 1))
print(sum(seen(x) for x in seen([1, 2])))
print(any(seen(x) > 2 for x in xs))
print(all(seen(x) < 4 for x in xs))
print(any(x > 9 for x in xs), all(x > 0 for x in xs))
print(any(x for x in []), all(x for x in []))
print(any(seen(i) == seen(j) for i in range(3) for j in range(2) if i))
print(min(x - 2 for x in xs), max(len(w) for w in ["héllo", "ü"]))
print(max((a, b) for a, b in zip("ab", [2, 1])))
print(list(c for c in "héllo" if c != "l"))
print(sorted(set(x % 3 for x in xs)))
print(sorted(x for x in xs), sorted((x for x in xs), reverse=True))
print("-".join(w.upper() for w in ["zoë", "åsa"]))
print("".join(c for c in "naïve" if c != "a"))
print(sum(i * j for i in range(3) for j in range(i)))
print(sum(i for i, c in enumerate("añb") if c != "ñ"))
print(sum(x / 2 for x in xs), sum(x for x in [0.1] * 10))
x = "outer"
print(sum(len(x) for x in ["ab", "c"]), x)
grid = [[1, 2], [3, 4]]
print(sum(sum(v for v in row) for row in grid))
print(max(sum(r) for r in grid), min(all(v > 1 for v in r) for r in grid))


def total(rows: list[list[int]]) -> int:
    return sum(v for r in rows for v in r if v % 2 == 0)


print(total(grid))
