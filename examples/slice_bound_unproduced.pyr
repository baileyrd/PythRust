# Never-produced slice bounds retain their original faults in native code.
def get(xs):
    return xs[0]
def forward(xs):
    return get(xs)
def cut(xs, n):
    return xs[n:]
xs = []
d = {}
print("index str start")
try:
    print("aé🙂"[xs[0]:])
except IndexError as e:
    print(e)
xs = []
d = {}
print("index str stop")
try:
    print("aé🙂"[:xs[0]])
except IndexError as e:
    print(e)
xs = []
d = {}
print("index str step")
try:
    print("aé🙂"[::xs[0]])
except IndexError as e:
    print(e)
