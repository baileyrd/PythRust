# A representative from one call must not constrain the generic scheme.
xs = []
try:
    print(cut([0, 1, 2], get(xs)))
except IndexError as e:
    print(e)
print(cut([0, 1, 2], True), cut("aé🙂", 1))
def receiver():
    print("receiver")
    return ["é", "🙂"]
def later(n):
    print("later", n)
    return n
xs = []
try:
    print(receiver()[get(xs):later(2):later(1)])
except IndexError as e:
    print(e)
print("after faults")
