# Slices count code points, not bytes or graphemes.
s = "aé🙂éΩ"
for a in [-9223372036854775808, -100, -6, -1, 0, 3, 6, 100, 9223372036854775807]:
    for b in [-9223372036854775808, -7, -1, 0, 3, 7, 9223372036854775807]:
        for c in [-9223372036854775808, -7, -2, -1, 1, 2, 7, 9223372036854775807]:
            print(s[a:b:c])
for c in [-9223372036854775808, -2, -1, 1, 2, 9223372036854775807]:
    print((s[::c], s[:3:c], s[2::c], s[:-1:c], ""[::c]))
print(s[:], s[2:2], "abc"[::-1])
def cut(x, start, stop, step):
    return x[start:stop:step]
print(cut(s, -5, 99, 2), cut([1, 2, 3], -3, 99, 2))
