# deviation: a closure that captures cannot escape as a value until step 6-3b (D202); CPython allows it.
# expect-exit: 1
# expect-error: `add` captures names, so it cannot be a function value yet

from collections.abc import Callable


def make(k: int) -> Callable[[int], int]:
    def add(n: int) -> int:
        return n + k

    return add


print(make(1)(2))
