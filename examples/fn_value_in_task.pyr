# deviation: a function value called inside a task is a named error (D196); CPython runs it.
# expect-exit: 1
# expect-error: a function value is called inside a task; rule 4 cannot see its callee yet

from collections.abc import Callable
from concurrent.futures import ThreadPoolExecutor


def d(x: int) -> int:
    return x * 2


def run(g: Callable[[int], int], x: int) -> int:
    return g(x)


def main() -> None:
    with ThreadPoolExecutor() as ex:
        fut = ex.submit(run, d, 3)
        print(fut.result())


main()
