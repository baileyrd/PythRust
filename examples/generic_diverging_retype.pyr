# A variable read before a later live assignment, where only a call that
# never returns has assigned it so far, takes the live value's type: in
# a branch and in a loop, for ints and floats, through a generic wrapper.
def spin(n):
    return spin(n - 1)


def h(n, x):
    if n:
        y = spin(n)
    if n:
        print(y)
    y = x * x
    return y


def looped(n, x):
    if n:
        y = spin(n)
    i = 0
    while i < 2:
        if i:
            print(y)
        y = x * x
        i += 1
    return y


def o(x):
    return h(0, x) + 1


def p(x):
    return looped(0, x) + 1


print(o(3), o(1.5))
print(p(3), p(1.5))
