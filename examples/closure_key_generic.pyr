def nearest(xs: list[int], k: int) -> list[int]:
    def go() -> list[int]:
        return sorted(xs, key=lambda x: abs(x - k))

    return go()


def by_weight(words: list[str], weight: dict[str, int]) -> str:
    def best() -> str:
        return max(words, key=lambda w: weight.get(w, 0))

    return best()


def ranked(xs):
    return [(i, x) for i, x in enumerate(xs)]


def doubled(xs):
    return [neg(p[1]) for p in [(0, x) for x in xs]]


def neg(x):
    return -x


print(nearest([5, 1, 3, 2], 2))
print(by_weight(["a", "bé", "c"], {"bé": 3, "c": 1}))
print(ranked(["x", "y"]), ranked([1.5]))
print(doubled([4, 7]))
