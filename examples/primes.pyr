def sieve(limit):
    is_prime = []
    for _ in range(limit + 1):
        is_prime.append(True)
    is_prime[0] = False
    is_prime[1] = False
    i = 2
    while i * i <= limit:
        if is_prime[i]:
            j = i * i
            while j <= limit:
                is_prime[j] = False
                j += i
        i += 1
    primes = []
    for k in range(limit + 1):
        if is_prime[k]:
            primes.append(k)
    return primes


def is_prime_trial(n):
    if n < 2:
        return False
    d = 2
    while d * d <= n:
        if n % d == 0:
            return False
        d += 1
    return True


ps = sieve(100)
print(ps)
print(len(ps))
count = 0
for n in range(1000):
    if is_prime_trial(n):
        count += 1
print(count)
