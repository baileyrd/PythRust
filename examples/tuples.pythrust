a, b = 1, 2
print(a, b)
a, b = b, a
print(a, b)

x, y, z = 1, 2, 3
x, y, z = z, x, y
print(x, y, z)

p = (3, "three")
print(p)
print(p[0], p[1])
print(p[-1], p[-2])

single = (7,)
print(single)
print(len(single))
print(())

(m, n), k = (1, 2), 3
print(m, n, k)


def divmod_pair(a, b):
    return a // b, a % b


q, r = divmod_pair(17, 5)
print(q, r)
print(divmod_pair(-17, 5))

pairs = [(1, "one"), (2, "two"), (3, "three")]
for num, name in pairs:
    print(num, name)
print(pairs)
