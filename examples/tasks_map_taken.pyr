# `map`'s results are an iterator (M6c): taken once, in order, and
# true even when empty or used up. `in` takes results up to the first
# match; an exception a task raised ends them. A loop keeps the results
# it started with when their name is rebound. `is` and `is not` take
# none: they compare identity with `None`. A result never taken
# drops its exception. Results of any type, over any iterable.
import concurrent.futures


def square(x: int) -> int:
    if x == 3:
        raise ValueError("three")
    return x * x


def pair(s: str) -> list[str]:
    return [s, s + s]


def scaled(x: int, k: int = 10) -> int:
    return x * k


def nothing(x: int) -> None:
    pass


def main() -> None:
    with concurrent.futures.ThreadPoolExecutor() as ex:
        rs = ex.map(square, [1, 2])
        print(not rs, list(rs), not rs)
        if ex.map(square, []):
            print("empty results are true")
        rs = ex.map(square, [1, 2, 4, 5])
        print(9 not in rs, list(rs))
        rs = ex.map(square, [5, 1, 4, 2])
        for r in rs:
            print("first", r)
            break
        print(sorted(rs))
        rs = ex.map(square, [2, 2, 1])
        print(4 in rs, sorted(set(rs)))
        try:
            print(16 in ex.map(square, [1, 3, 4]))
        except ValueError as e:
            print("caught", e)
        ex.map(square, [3, 3])
        rs = ex.map(square, [3, 1])
        print("never taken")
        for p in ex.map(pair, "ab"):
            print(p)
        print(list(ex.map(scaled, range(3))))
        print(list(ex.map(scaled, {4: "x", 5: "y"})))
        rs = ex.map(square, [1, 3, 2])
        try:
            print(sorted(rs))
        except ValueError as e:
            print("caught", e, list(rs))
        rs = ex.map(square, [1, 2])
        for r in rs:
            print("rebound", r)
            rs = ex.map(square, [4])
        print(list(rs))
        rs = ex.map(square, [1, 2])
        others = ex.map(square, [5])
        print(list(rs or others), list(others))
        none = ex.map(nothing, [])
        print(None is none, none is None, None is not none, none is not None)
        none = ex.map(nothing, [1])
        print(None is none, none is None, None is not none, none is not None)
        print(list(none))
        ps = ex.map(pair, ["x", "y"])
        for p in ps:
            p.append("!")
            print(p)
        else:
            print("done", list(ps))


main()
