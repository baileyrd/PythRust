# deviation: a bool stored as a key of an int-keyed dict or set is stored as its int, where CPython keeps True; run cannot tell a table a generic function makes is int-keyed until code with a concrete type sees it, so a generic body that shows its own table first shows True (docs/grammar.md#deviations-from-python). build refuses this program (NATIVE_GAPS).
def build(k):
    d = {}
    d[k] = 1
    print(d)
    return d
def build_set(x):
    s = set()
    s.add(x)
    print(s)
    return s
by_int: dict[int, int] = build(True)
print(by_int)
ints: set[int] = build_set(False)
print(ints)
def new():
    return {}
def put(d, k):
    d[k] = "p"
made: dict[int, str] = new()
put(made, True)
print(made)
