# deviation: A5 rejects a tempered call sharing a list after a loose callee stores it; CPython has no modes.
# expect-error: tempered `add` keeps `row` after it returns, and this call may also pass that list as `rows`; pass a copy (`list(...)`)
# expect-exit: 1
temper def add(mut rows: list[list[int]], owned row: list[int]) -> None:
    rows.append(row)

rows: list[list[int]] = []
row = [1]
def stash(x):
    rows.append(x)
stash(row)
add(rows, row)
print(rows)
