# deviation: a closure over a name bound after it needs cells that may be unbound (D204, step 6-3b-2b); CPython reads the loop target at each call.
# expect-exit: 1
# expect-error: `x` is captured by `sq` but not bound before it

def squares(xs: list[int]) -> list[int]:
    def sq() -> int:
        return x * x

    out: list[int] = []
    for x in xs:
        out.append(sq())
    return out


print(squares([1, 2, 3]))
