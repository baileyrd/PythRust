# Equal prefix fields must skip ordering even for NaN and signed zero.
n = float("nan")
print((n,) < (0.0, 1), (n,) <= (0.0, 1), (n,) > (0.0, 1), (n,) >= (0.0, 1))
print((-0.0,) < (0, 1), (-0.0,) <= (0, 1), (-0.0,) > (0, 1), (-0.0,) >= (0, 1))
print(((1,),) < ((1.0,), 9), ((1,),) <= ((1.0,), 9), ((1,),) > ((1.0,), 9), ((1,),) >= ((1.0,), 9))
print((1, "é") < (1.0, "Ω"), (1, "é") <= (1.0, "Ω"), (1, "é") > (1.0, "Ω"), (1, "é") >= (1.0, "Ω"))
def ordered(a, b):
    return a < b, a <= b, a > b, a >= b
print(ordered((1,), (1, 2)))
print(ordered(((1,),), ((1.0,), 9)))
print((1, 2) == (1, 2), (1, 2) != (1, 2))
def left():
    print("left")
    return (1,)
def middle():
    print("middle")
    return (1, 2)
def last():
    print("last")
    return (2,)
print(left() < middle() < last())
print(last() < middle() < left())
def bad():
    print("bad")
    return 1 // 0
try:
    print((0,) < (1, bad()))
except ZeroDivisionError:
    print("right operand fault")
try:
    print((bad(),) < (1, 2))
except ZeroDivisionError:
    print("left operand fault")
print((0,) < (1, 2) or bad() > 0)
print((2,) < (1, 2) and bad() > 0)
