print(7 + 3, 7 - 3, 7 * 3)
print(7 / 2, 8 / 2, -7 / 2)
print(7 // 2, -7 // 2, 7 // -2, -7 // -2)
print(7 % 3, -7 % 3, 7 % -3, -7 % -3)
print(2 ** 10, 2 ** 0, (-2) ** 3, -2 ** 2)
print(2 ** 3 ** 2)
print(-(-5), +5, -+-5)
print(1 + 2 * 3 - 4 // 2)
print((1 + 2) * (3 - 4))
print(7.5 // 2, -7.5 // 2, 7.5 % 2)
print(1 + 2.5, 3 * 1.5)

x = 10
x += 5
x -= 3
x *= 2
x //= 5
x %= 3
x **= 3
print(x)
y = 7.0
y /= 2
print(y)

print(9223372036854775807)
print(-9223372036854775808)
print(-9223372036854775807 - 1)
print(1_000_000 + 1)
print(1 == 1.0, 2 != 2.5, 3 < 3.5)
