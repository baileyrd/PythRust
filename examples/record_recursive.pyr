from __future__ import annotations

from dataclasses import dataclass


# Lazy annotations let a record hold its own type (D162): through an
# optional, which cannot close a cycle, so `build` accepts it (D166, #1457).
@dataclass(frozen=True)
class Link:
    value: str
    nxt: Link | None

    def length(self) -> int:
        nxt = self.nxt
        if nxt is None:
            return 1
        return 1 + nxt.length()


chain = Link("ä", Link("ö", Link("ü", None)))
print(chain.length())
print(chain)
print(chain == Link("ä", Link("ö", Link("ü", None))))


# Two records that hold each other, through tuples and optionals.
@dataclass(frozen=True)
class Even:
    n: int
    rest: tuple[Odd, int] | None


@dataclass(frozen=True)
class Odd:
    n: int
    rest: Even | None


odd = Odd(1, Even(2, (Odd(3, None), 7)))
print(odd)
print(odd == Odd(1, Even(2, (Odd(3, None), 7))), odd == Odd(1, None))
