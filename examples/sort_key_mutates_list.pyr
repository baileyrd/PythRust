# deviation: D187: a key that changes the list `list.sort` is sorting finishes here, where CPython raises `ValueError: list modified during sort`.
words = ["bb", "a", "ccc"]


def grow(s: str) -> int:
    words.append("z")
    return len(s)


try:
    words.sort(key=grow)
    print(words)
except ValueError as e:
    print("caught", e)
