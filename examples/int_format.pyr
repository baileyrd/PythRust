import concurrent.futures

def render(n: int) -> str:
    text = str(n)
    return text + ":é🙂中:" + str(len(text))

def main() -> None:
    values = [-9223372036854775808, -1000000000000000001, -1000000000000000000, -999999999999999999, -100000000000000001, -100000000000000000, -99999999999999999, -10000000000000001, -10000000000000000, -9999999999999999, -1000000000000001, -1000000000000000, -999999999999999, -100000000000001, -100000000000000, -99999999999999, -10000000000001, -10000000000000, -9999999999999, -1000000000001, -1000000000000, -999999999999, -100000000001, -100000000000, -99999999999, -10000000001, -10000000000, -9999999999, -1000000001, -1000000000, -999999999, -100000001, -100000000, -99999999, -10000001, -10000000, -9999999, -1000001, -1000000, -999999, -100001, -100000, -99999, -10001, -10000, -9999, -1001, -1000, -999, -101, -100, -99, -11, -10, -9, -2, -1, 0, 1, 2, 9, 10, 11, 99, 100, 101, 999, 1000, 1001, 9999, 10000, 10001, 99999, 100000, 100001, 999999, 1000000, 1000001, 9999999, 10000000, 10000001, 99999999, 100000000, 100000001, 999999999, 1000000000, 1000000001, 9999999999, 10000000000, 10000000001, 99999999999, 100000000000, 100000000001, 999999999999, 1000000000000, 1000000000001, 9999999999999, 10000000000000, 10000000000001, 99999999999999, 100000000000000, 100000000000001, 999999999999999, 1000000000000000, 1000000000000001, 9999999999999999, 10000000000000000, 10000000000000001, 99999999999999999, 100000000000000000, 100000000000000001, 999999999999999999, 1000000000000000000, 1000000000000000001, 9223372036854775807]
    for n in values:
        print(n, render(n))
    with concurrent.futures.ThreadPoolExecutor() as ex:
        for text in ex.map(render, values):
            print(text)

main()
