# deviation: tempered code marks each wait on a task with `pause` (M6c, Nano 2026-11-02); CPython runs it with the markers removed, and this one has none.
# expect-exit: 1
# expect-error: each step of this loop waits on a task; tempered `squares` marks it: write `pause` before it
import concurrent.futures


temper def square(x: int) -> int:
    return x * x


temper def squares(xs: list[int]) -> list[int]:
    out: list[int] = []
    with concurrent.futures.ThreadPoolExecutor() as ex:
        for r in ex.map(square, xs):
            out.append(r)
    return out


print(squares([1, 2]))
