# deviation: a def that changes its parameter is not a function value yet (D191); CPython allows it.
# expect-exit: 1
# expect-error: `push` changes its parameter `xs`, so it cannot be a function value yet

def grow(mut xs: list[int]) -> None:
    xs.append(1)


def push(mut xs: list[int]) -> None:
    grow(xs)


f = push
