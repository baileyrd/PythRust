print()
print("a", "b", "c")
print(None, True, False)
print([1, 2, 3], [], ["x", "y"])
print([[1, 2], [3]])
print(str(12), str(1.5), str(True), str(None))
print(int("42"), int("-7"), int(7.0))
print(float(1), float("3.5"))
print(bool(0), bool(1), bool(""), bool("a"), bool([]), bool([0]))
print(len([1, 2, 3]), len("four"), len((1, 2)))
for i in range(10, 0, -3):
    print(i)
for i in range(0):
    print("never")
xs = []
for i in range(5, 8):
    xs.append(i * i)
print(xs)
