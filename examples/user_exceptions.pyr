# User exception classes (D138-D143): derived from a builtin class,
# raised with or without a message, caught by their own name or a base.
class AppError(Exception):
    "An application failure · ü."


class ParseError(ValueError):
    pass


class Missing(KeyError):
    pass


def parse(s: str) -> int:
    if s == "":
        raise ParseError("empty · é")
    return int(s)


temper def strict(s: str) -> int raises ParseError, ValueError:
    return parse(s)


def check(n: int) -> int:
    if n < 0:
        raise AppError
    return n


for s in ["12", "", "x"]:
    try:
        print(strict(s))
    except ParseError as e:
        print("parse:", e, repr(e))
    except ValueError as e:
        print("value:", e)

try:
    check(-1)
except AppError as e:
    print("app:", repr(e), str(e) == "")

try:
    raise Missing("k · ✓")
except LookupError as e:
    print("lookup:", e, repr(e))

try:
    raise ParseError("tuple · ñ")
except (AppError, ParseError) as e:
    print("tuple:", e)

try:
    raise AppError(3)
except Exception as e:
    print("base:", e, repr(e))


def wrap() -> None:
    try:
        parse("")
    except ValueError as e:
        raise AppError(e)


try:
    wrap()
except AppError as e:
    print("wrapped:", e)
print(f"{ParseError('f · é')}")
print(check(4))
