# deviation: a generic function using tasks whose result type only its body decides is a compile error until tasks lower to the IR, so the ownership checks never skip the program (M6c, Nano 2026-11-02); CPython runs it.
# expect-exit: 1
# expect-error: annotate `run`'s parameters and result
import concurrent.futures


def double(n):
    return n * n


def run(x):
    with concurrent.futures.ThreadPoolExecutor() as ex:
        return ex.submit(double, x).result()


def outer(y):
    return run(y) + 1


print(outer(2))
