# A module list read by a task while the submitter reads it too. Correct
# as written: the list is marked before the task is queued. CI's race job
# also runs it against a runtime that skips every mark
# (`PYTHRUST_FAULT=unmarked`), where ThreadSanitizer must report a race.
import concurrent.futures

DATA: list[int] = [3, 1, 4, 1, 5, 9, 2, 6]


def total(n: int) -> int:
    t = 0
    for i in range(n):
        t += DATA[i % 8]
    return t


def main() -> None:
    with concurrent.futures.ThreadPoolExecutor() as ex:
        f = ex.submit(total, 20000)
        t = 0
        for i in range(20000):
            t += DATA[i % 8]
        print(t, f.result())


main()
