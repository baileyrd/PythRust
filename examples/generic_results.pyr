# Generic functions whose result type their signature leaves open: the
# native backend takes it from each instance's body.
def square(n):
    return n * n


def apply_twice(n):
    return square(square(n))


def mean(a, b):
    total = a + b
    return total / 2


def pair(x):
    return [x, x]


def swap(a, b):
    return (b, a)


def total(xs, i):
    if i == len(xs):
        return 0
    return xs[i] + total(xs, i + 1)


def label(x):
    s = str(x)
    return s + "!" if len(s) > 1 else s


print(apply_twice(3), apply_twice(1.5))
print(mean(1, 2), mean(1.5, 2.5))
print(pair(3), pair("a"), len(pair([1])))
print(swap(1, "b"), swap(square(2), square(0.5)))
print(total([1, 2, 3], 0))
print(label(7), label(12), label(2.5))


def fact(n):
    if n > 1:
        return n * fact(n - 1)
    return 1


def is_even(n):
    if n == 0:
        return True
    return is_odd(n - 1)


def is_odd(n):
    if n == 0:
        return False
    return is_even(n - 1)


print(fact(5), is_even(10), is_odd(7))


# Containers whose items the signature leaves open, through generic
# callers: the instance's displays decide them.
def squares(n):
    return [n * n]


def count(n):
    return len(squares(n))


def grow(n):
    xs = squares(n)
    xs.append(n * n + 1)
    return xs


def boxed(n):
    return (n * n, [n])


def unbox(n):
    a, b = boxed(n)
    return a + b[0]


def walk(n):
    s = 0 * n
    for p in [(n, n * n)]:
        a, b = p
        s += a + b
    return s


print(count(3), grow(2), grow(1.5), unbox(3), unbox(0.5), walk(2), walk(0.5))


# A recursive call before the first `return` that decides the result.
def rec(n, x):
    if n > 0:
        return rec(n - 1, x) + x
    return x * x


def outer(x):
    return rec(2, x) + 1


def ping(n, x):
    if n > 0:
        return pong(n - 1, x) + x
    return x * x


def pong(n, x):
    return ping(n, x)


print(outer(3), outer(0.5), ping(3, 2), ping(1, 1.5))
