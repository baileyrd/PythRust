# `repr` of a string, as `print` of a list shows it, escapes what CPython
# escapes (D54): controls, separators other than space (U+00A0, U+3000,
# U+2028) and private use, at `\x`, `\u` and `\U` widths.
print(["a b", " ", "　", " ", " ", " "])
print(["\x00", "\x1f", "\x7f", "\x85", "\t\n\r", "\\"])
print(["", "\U000f0000", "\U0010fffd"])
print(("ßΣ中", "it's", 'say "hi"'))
print({"k　": "v "})
