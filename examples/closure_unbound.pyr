# deviation: a closure over a name bound after it needs cells (D204, step 6-3b); CPython raises NameError only if the name is read unbound.
# expect-exit: 1
# expect-error: `x` is captured by `get` but not bound before it; captures of a variable bound later or conditionally need cells (not supported yet)

def pick() -> int:
    def get(read: bool) -> int:
        if read:
            return x
        return 0

    first = get(False)
    x = 5
    return first + get(True)


print(pick())
