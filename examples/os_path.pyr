# `os` and `os.path` without touching real files: joining, tests on a
# missing path, and the `OSError` subclasses a missing path raises,
# caught by class (their messages differ on Windows). CPython on Windows
# joins with `\\` (a listed deviation), so joins are checked against both
# separators and paths are not printed.
import os


def joined(got: str, posix: str, windows: str) -> bool:
    return got == posix or got == windows


print(os.path.join("a") == "a", joined(os.path.join("a", "b", "c"), "a/b/c", "a\\b\\c"))
print(joined(os.path.join("a/", "b"), "a/b", "a/b"), os.path.join("", "b") == "b")
print(joined(os.path.join("a", "/b", "c"), "/b/c", "/b\\c"))
print(joined(os.path.join("a", ""), "a/", "a\\"))
missing = os.path.join("no", "such", "path")
print(os.path.isdir(missing), os.path.isfile(missing), os.path.islink(missing))
print(os.path.isdir("."), os.path.isfile("."))


temper def size(path: str) -> int raises OSError:
    return os.path.getsize(path)


def names(path: str) -> list[str]:
    try:
        return os.listdir(path)
    except FileNotFoundError:
        print("not found")
        return []


try:
    print(size(missing))
except FileNotFoundError:
    print("FileNotFoundError")
print(names(missing))
try:
    os.listdir(missing)
except OSError as e:
    print("OSError caught", str(e) != "")
print(len(os.listdir()) > 0, os.listdir(path=".") == os.listdir("."))
try:
    os.listdir(path=missing)
except FileNotFoundError as e:
    print("FileNotFoundError by keyword")
