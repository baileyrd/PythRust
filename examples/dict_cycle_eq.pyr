# native-stderr: the runtime reports the fault without a source location, so its stderr is "pythrust-rt: RecursionError: maximum recursion depth exceeded in comparison" where `run` shows the line and carets.
# expect-exit: 1
from __future__ import annotations

from dataclasses import dataclass


@dataclass
class Hub:
    links: dict[str, Hub]


def main() -> None:
    a = Hub({})
    a.links["self"] = a
    a.links["only_a"] = a
    b = Hub({})
    b.links["self"] = b
    b.links["only_b"] = b
    # The keys differ, but "self" comes first, so its values are compared
    # (forever) before the missing key is looked up, as in CPython.
    print(a == a)
    print("comparing")
    print(a == b)
    print("not reached")


main()
