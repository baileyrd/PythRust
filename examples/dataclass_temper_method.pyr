# A tempered method on a mutable dataclass: ownership checks see the
# object (#1264, D157); `add` changes `self`, so it writes `mut self`
# (D149). The error neighbour is `class_temper_self_mode`.
from dataclasses import dataclass


@dataclass
class Counter:
    total: int

    temper def add(mut self, k: int) -> None:
        self.total += k


c = Counter(0)
c.add(2)
print(c, "é")
