def fib_rec(n):
    if n < 2:
        return n
    return fib_rec(n - 1) + fib_rec(n - 2)


def fib_iter(n):
    a, b = 0, 1
    for _ in range(n):
        a, b = b, a + b
    return a


for i in range(15):
    print(i, fib_rec(i), fib_iter(i))

# fib(92) is the largest Fibonacci number that fits in i64.
print(fib_iter(92))
