# expect-exit: 1
# A for loop over d.keys(), d.values() or d.items() runs over the dict itself, so adding a key stops the program with a RuntimeError.
d = {1: "a", 2: "b"}
for k, v in d.items():
    d[k] = v + "!"
for k in d.keys():
    d[k] = d[k] + "?"
print(d)
for v in d.values():
    print(v)
    d[len(d) + 1] = v
print("not reached")
