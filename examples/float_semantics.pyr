# Floats: the numeric tower, NaN, overflow to inf, truthiness, conversions.
def mean(a, b):
    return (a + b) / 2


def area(r):
    return 3.14159 * r ** 2


x = 7.5
x += 1
x -= 0.25
x *= 2
print(x, -x, +x, x // 2, x % 2, -x // 2, -x % 2, x / 4)
print(mean(1, 2), mean(1.5, 2), area(2), area(1.5))
print(2 ** 10, 2.0 ** -1, (-2) ** 3, 2 ** 0.5, 10 % 3, 7 // -2)
print(1 < 1.5, 2.0 == 2, 3 > 2.5, 0.1 + 0.2 != 0.3, 1.0 <= 1)
print(int(2.9), int(-2.9), float(3), float(True), int("  12 "), float("1e3"), float("-inf"))
print(str(0.5) + "!", str(1e20), str(-0.0))
y = 0.0
if not y:
    print("zero is falsy")
z = 1.0 if y else 2.5
print(z, y or 4.5, 3.0 and 0.0)
nan = float("nan")
print(nan == nan, nan != nan, nan < 1, 1e308 * 10, -1e308 * 10)
t = 0.0
for i in range(5):
    t += i * 0.5
print(t, 1 / 3, 10 / 4, 9 / 3)
