# deviation: a closure over a name bound only in a branch needs cells (D204, step 6-3b); CPython raises NameError only when it is read unbound.
# expect-exit: 1
# expect-error: `label` is captured by `show` but not bound before it; captures of a variable bound later or conditionally need cells (not supported yet)

def describe(n: int) -> str:
    if n > 0:
        label = "positive"

    def show() -> str:
        return label + "!"

    return show()


print(describe(3))
