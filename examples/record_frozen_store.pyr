# deviation: D131: assigning a field is a compile error; CPython raises FrozenInstanceError when it runs.
# expect-error: cannot assign to field `x` of frozen record `Point`
# expect-exit: 1
from dataclasses import dataclass


@dataclass(frozen=True)
class Point:
    x: int
    y: int


p = Point(1, 2)
print(p)
p.x = 3
print(p)
