# Ints, bools and control flow only: the first native-backend subset.
def floor_ops(a, b):
    print(a // b, a % b)


def count(start, stop, step):
    n = 0
    last = start
    for i in range(start, stop, step):
        n += 1
        last = i
    else:
        n = -n
    return n * 1000 + last % 1000


def first_multiple(limit, k):
    i = 1
    while i < limit:
        if i % k == 0:
            break
        i += 1
    else:
        return -1
    return i


def same(x):
    return x


floor_ops(7, 2)
floor_ops(-7, 2)
floor_ops(7, -2)
floor_ops(-7, -2)
floor_ops(-9223372036854775807 - 1, 1)
floor_ops(5, -1)
print(count(0, 10, 3), count(10, 0, -3), count(5, 5, 1))
big = 9223372036854775807
print(count(big - 5, big, 2))
print(count(-big - 1, -big + 5, 2))
print(first_multiple(10, 4), first_multiple(10, 11))
total = 0
for i in range(20):
    if i % 3 == 0:
        continue
    if i > 15:
        break
    total += i
print(total)
a, b = 1, 2
a, b = b, a
print(a, b, same(True), same(3), same(None))
print(1 < 2 < 3, 1 < 3 < 2, 2 == 2 != 3, not 0, not 5)
print(0 or 7, 4 and 9, 0 and 9, False or True)
print(3 if a > b else 4, -a, +b, -(-a))
x = None
print(x is None, a is not None)
