# deviation: D132: base classes are not supported yet; CPython runs them.
# expect-error: base classes are not supported yet
# expect-exit: 1
from dataclasses import dataclass


@dataclass(frozen=True)
class Point:
    x: int
    y: int


@dataclass(frozen=True)
class Point3(Point):
    z: int


print(Point3(1, 2, 3))
