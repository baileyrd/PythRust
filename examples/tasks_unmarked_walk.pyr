# A module list a task walks with `for` while the submitter walks it too.
# Each loop holds the list (one read borrow for the loop), not a borrow
# per read. Correct as written: the list is marked before the task is
# queued. CI's race job also runs it against a runtime that skips every
# mark (`PYTHRUST_FAULT=unmarked`), where ThreadSanitizer must still
# report a race. Ints have no counts, so the only shared writes are the
# holds themselves.
import concurrent.futures

DATA: list[int] = [3, 1, 4, 1, 5, 9, 2, 6]


def total(n: int) -> int:
    t = 0
    for _ in range(n):
        for x in DATA:
            t += x
    return t


def main() -> None:
    with concurrent.futures.ThreadPoolExecutor() as ex:
        f = ex.submit(total, 5000)
        print(total(5000), f.result())


main()
