# deviation: D131: a method that changes `self` waits for step 5; CPython runs it.
# expect-error: a method that changes or keeps `self` is not supported yet
# expect-exit: 1
from dataclasses import dataclass


@dataclass(frozen=True)
class Bag:
    items: list[str]

    def put(self, s: str) -> None:
        self.items.append(s)


b = Bag([])
b.put("é")
print(b)
