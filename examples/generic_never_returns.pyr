# expect-exit: 1
# A generic function whose every `return` needs its own result never
# returns: it builds natively and fails as `run` does.
def spin(n):
    return spin(n + 1) if n else spin(n - 1)


def f(n):
    return f(n - 1)


def g(x):
    return f(x)


print("start")
print(g(1))
print(spin(1))
