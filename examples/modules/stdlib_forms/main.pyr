# `from`, dotted and `as` on standard modules (D84).
import sys as s
import os.path
import os.path as osp
from os import path
from os.path import join as j, isdir
from sys import argv
from concurrent.futures import ThreadPoolExecutor
from hashlib import sha256


def twice(n: int) -> int:
    return 2 * n


def main() -> None:
    with ThreadPoolExecutor() as ex:
        print(ex.submit(twice, 21).result())


print(len(s.argv), len(argv), argv == s.argv)
# Separators differ by OS, so compare forms instead of printing paths.
f = j("dir", "fïle")
print(f.endswith("fïle"), f == path.join("dir", "fïle"), f == os.path.join("dir", "fïle"))
print(osp.isdir("."), os.path.isdir("."), isdir("."))
data = open(argv[0], "rb").read()
print(len(sha256(data).hexdigest()))
main()
